<!--
This is your User Page.
This page will allow the User to view/edit their information
and view events the User has RSVP'ed to. 
-->
<body>
  <!-- User Info -->
  <div> 
    <h1><%= user.name %></h1>
    <img src="/images/default-user.png" alt="Avery Lane" class="profile-pic">
    <p>
      <span>Email:</span> <%= user.email %><br>
      <span>Phone Number:</span> <%= user.phone %><br>
      <a href="/user/edit">Edit User Details</a>
    </p>
  </div>

  <!-- User's Events -->
  <div>
    <h2>Events you have joined:</h2>

    <% userEvents.forEach(event => { %>
      <div class="event-card">
        <h3><%= event.name %></h3>
        <p><strong>Location:</strong> <%= event.location %></p>
        <p><strong>Date:</strong> <%= event.date %></p>
        <p><strong>Description:</strong> <%= event.description %></p>
        <p><strong>Event ID:</strong> <%= event.id %></p>
        <hr/>
      </div>
    <% }) %>
  </div>

  <!-- Return Home -->
  <a href="/">Return Home</a>
</body>
