<head>
    <title>Add Event</title>
  </head>
  <body>
    <h1>Add a Local Event</h1>
    <% if (typeof message !== 'undefined' && message) { %>
      <div style="background-color: #e0ffe0; padding: 10px; border: 1px solid #66cc66; margin-bottom: 15px;">
        <%= message %>
      </div>
    <% } %>
    
  
    <!-- Form to EventController.handleAddForm -->
    <form action="/events/local/add" method="POST">
      <label for="name">Event Name:</label>
      <input type="text" name="name" required><br>
    
      <label for="location">ZIP Code:</label>
      <input type="text" name="location" required><br>
    
      <label for="date">Date:</label>
      <input type="date" name="date" required><br>
    
      <label for="time">Time:</label>
      <input type="time" name="time" required><br>
    
      <label for="description">Description:</label>
      <textarea name="description" required></textarea><br>
    
      <label for="lat">Latitude:</label>
      <input type="text" name="lat" required><br>
    
      <label for="lng">Longitude:</label>
      <input type="text" name="lng" required><br>
    
      <button type="submit">Add Event</button>
    </form>
    <br>
    <a href="/">Return Home</a>
  </body>