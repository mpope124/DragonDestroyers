<head>
  <title>Delete Event</title>
</head>
<body>
  <!-- Navbar -->
  <ul class = "nav">
    <li><a href="/">Home</a></li>
    <li><a href="/event/add">Add Event</a></li>
    <li><a href="/event/delete" class = "active">Delete Event</a></li>
    <li><a href="/userpage">User Profile</a></li>
    <li><a href="/events/zip">Find Events by ZIP</a></li>

  </ul>  
  <h1 class="heading">Delete an Event</h1>


  <!-- Form to EventController.handleDeleteForm -->
  <form action="/events/local/delete" method="POST" class = "inputForm">
    <label>Select Event to Delete:</label><br>
    <select name="id" required>
      <% events.forEach(event => { %>
        <option value="<%= event.id %>"><%= event.name %> — <%= event.date %></option>
      <% }) %>
    </select>
    <br><br>
    
    <button type="submit" style="color: red;">Delete Event</button>
  </form>
  
  <br>
  
</body>