<!--
This an extension of User Page.
This page will allow the User to view/edit their information
-->
<body>
  <!-- Navbar -->
  <ul class = "nav">
    <li><a href="/">Home</a></li>
    <li><a href="/event/add">Add Event</a></li>
    <li><a href="/event/delete">Delete Event</a></li>
    <li class = "active"><a href="/userpage">User Profile</a></li>
    <li><a href="/events/zip">Find Events by ZIP</a></li>
  
  </ul>
  
    <h1 class="heading">Edit User Details</h1>
    <form action="/user/update" method="POST" class="inputForm">
      
      <div class = "form-group">
        <label>Name:</label>
        <input type="text" name="name" value="<%= user.name %>" required /><br/>
      </div>
        
      <div class = "form-group">  
        <label>Email:</label>
        <input type="email" name="email" value="<%= user.email %>" required /><br/>
      </div>
  
      <div class = "form-group">
        <label>Phone:</label>
        <input type="text" name="phone" value="<%= user.phone %>" required /><br/>
      </div>
      <input type="submit" value="Save Changes"></input>
      <br><br>
      <a href="/userpage" class="cancel">Cancel</a>
    </form>
  </body>